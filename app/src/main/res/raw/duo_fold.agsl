// Duo-Fold Effect — AGSL port of DuoLikeAnimation/Shaders/DuoFold.metal.
//
// Model:
// - UI content lives on a fixed plane in world space (the zero-tilt screen plane).
// - Eye is stationary on that plane's normal through the screen center,
//   eyeDistancePx back from the plane.
// - The glass rotates about the screen centre on both axes at once, as a rigid
//   pane does when the phone is turned in the hand. The two measured tilt
//   angles are combined into one exact 3D rotation, so a diagonal tilt shears
//   the projected image the same way the real phone does instead of applying
//   two independent axis scalings.
// - Per pixel: ray from eye through the glass point, continued to the UI plane;
//   Vogel-disk blur with radius proportional to the glass-plane gap, dimmed
//   in proportion to how much it scatters. A fully-missed kernel is black.
// - perspective scales the projective compensation only. 1 is the exact
//   inverse perspective; 0 leaves the content unwarped and keeps the frost.
//
// Uniform conventions:
// - tiltHorizontalDegrees: left/right tilt. Positive = right side farther.
// - tiltVerticalDegrees: forward/back tilt. Positive = bottom side farther.
// - maxTiltDegrees: safety clamp matching the app's tuning slider.
// - perspective: 0..1 strength of the geometric tilt compensation.
// - blurSpread: blur radius gained per px of glass/plane separation.
// - darkening: fraction of light lost per px of blur radius.
//
// Compilation is covered by an on-device test, including the sample bounds helper.

uniform shader content;
uniform float2 resolution;
uniform float tiltHorizontalDegrees;
uniform float tiltVerticalDegrees;
uniform float eyeDistancePx;
uniform float maxTiltDegrees;
uniform float perspective;
uniform float blurSpread;
uniform float darkening;

const float GOLDEN_ANGLE = 2.39996322972865332; // radians, Vogel disk spacing
const float TWO_PI = 6.28318530717958648;

// RenderEffect child shaders can clamp outside the captured layer. A missed
// sample must be opaque black, not a stretched row of edge text or icons.
half4 samplePlane(float2 point) {
    if (point.x < 0.0 || point.y < 0.0 ||
        point.x >= resolution.x || point.y >= resolution.y) {
        return half4(0.0, 0.0, 0.0, 1.0);
    }
    return content.eval(point);
}

half4 main(float2 fragCoord) {
    float2 size = resolution;
    if (size.x <= 1.0 || size.y <= 1.0) {
        return content.eval(fragCoord);
    }

    float limit = max(maxTiltDegrees, 1.0);
    float tiltH = radians(clamp(tiltHorizontalDegrees, -limit, limit));
    float tiltV = radians(clamp(tiltVerticalDegrees, -limit, limit));
    if (abs(tiltH) < 1e-5 && abs(tiltV) < 1e-5) {
        return content.eval(fragCoord);
    }

    // Combine the two measured tilts into one exact rotation about the screen
    // centre. The screen normal fixes the horizontal and vertical angles; the
    // canonical no-roll rotation is R_y(tiltH) * R_x(alpha), where
    // tan(alpha) = tan(tiltV) * cos(tiltH). Using sin/cos directly avoids a
    // tangent blow-up near 90 degrees.
    float cH = cos(tiltH);
    float sH = sin(tiltH);
    float cV = cos(tiltV);
    float sV = sin(tiltV);
    float denom = sqrt(cV * cV + sV * sV * cH * cH);
    float sA = sV * cH / denom;
    float cA = cV / denom;

    // `p` is the signed offset of this pixel from the centre. `rotated` is the
    // same point after the rigid rotation, in screen coordinates; z is the
    // signed glass/content separation (negative = farther from the eye).
    float2 center = size * 0.5;
    float2 p = fragCoord - center;
    float3 rotated = float3(
        p.x * cH - p.y * sA * sH,
        p.y * cA,
        -(p.x * sH + p.y * sA * cH)
    );

    // Ray eye -> glass point, continued to the UI plane z = 0.
    float depth = eyeDistancePx - rotated.z;
    if (depth <= 1e-3) {
        return half4(0.0, 0.0, 0.0, 1.0);
    }
    float t = eyeDistancePx / depth;
    float2 projected = center + rotated.xy * t;

    // Strength control: blend toward the source pixel so the same projective
    // transform can be dialled down without turning into a translation.
    float2 hit = mix(fragCoord, projected, clamp(perspective, 0.0, 1.0));

    float radius = blurSpread * abs(rotated.z);

    // Whole blur kernel misses the UI: black.
    if (hit.x < -radius || hit.y < -radius ||
        hit.x > size.x + radius || hit.y > size.y + radius) {
        return half4(0.0, 0.0, 0.0, 1.0);
    }

    // Frosted glass absorbs: dim in proportion to how much it scatters.
    float atten = max(1.0 - darkening * radius, 0.0);

    if (radius < 0.5) {
        half4 sample = samplePlane(hit);
        return half4(sample.rgb * half(atten), sample.a);
    }

    // Vogel disk with per-pixel rotation (banding becomes frosted-glass grain).
    // Keep all 32 samples for small kernels too: no fractional sample-count
    // discontinuities or out-of-radius taps as the phone moves through neutral.
    float tapsF = 32.0;
    float rotation = fract(sin(dot(fragCoord, float2(12.9898, 78.233))) * 43758.5453) * TWO_PI;
    half3 sum = half3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 32; i++) {
        float fi = float(i);
        float r = radius * sqrt((fi + 0.5) / tapsF);
        float a = fi * GOLDEN_ANGLE + rotation;
        sum += samplePlane(hit + r * float2(cos(a), sin(a))).rgb;
        wsum += 1.0;
    }
    half3 avg = sum / half(max(wsum, 1.0));
    return half4(avg * half(atten), 1.0);
}
